{
  "name": "astraos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:web": "pnpm --filter @astraos/web dev",
    "dev:api": "cd services/api && uvicorn app.main:app --reload",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "baseline:check": "node scripts/check-rebuilt-baseline.mjs",
    "typecheck": "pnpm --filter @astraos/web typecheck",
    "lint": "pnpm --filter @astraos/web lint"
  },
  "dependencies": {
    "animejs": "^4.5.0"
  }
}
