# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=astraos
POSTGRES_PASSWORD=astraos
POSTGRES_DB=astraos
DATABASE_URL=postgresql+asyncpg://astraos:astraos@localhost:55432/astraos

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=astraos_documents_qwen3_8b

# Embeddings: OpenAI-compatible /embeddings endpoint
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=replace-with-embedding-api-key
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_PATH=/embeddings
EMBEDDING_VECTOR_SIZE=4096
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_HTTP_REFERER=http://localhost:3000
EMBEDDING_APP_TITLE=AstraOS

# LLM: OpenAI-compatible chat completions endpoint
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-with-llm-api-key
LLM_CHAT_PATH=/chat/completions
LLM_DEFAULT_MODEL=qwen/qwen3-32b
LLM_MODEL_FAST=qwen/qwen3-32b
LLM_MODEL_REASONING=qwen/qwen3-235b-a22b
LLM_MODEL_CODING=qwen/qwen3-coder
LLM_MODEL_LONG_CONTEXT=qwen/qwen3-235b-a22b
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_HTTP_REFERER=http://localhost:3000
LLM_APP_TITLE=AstraOS

# Local file storage
FILE_STORAGE_PATH=services/api/.data/uploads
TMP_STORAGE_PATH=services/api/.data/tmp
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=160
MAX_UPLOAD_FILE_SIZE_MB=20
ALLOWED_DOCUMENT_CONTENT_TYPES=text/plain,text/markdown,application/markdown,application/pdf

# API / frontend
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_DEV_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Auth
JWT_SECRET_KEY=replace-with-a-local-development-secret-32-bytes-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP email sender
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your-email@qq.com
SMTP_PASSWORD=replace-with-email-authorization-code
SMTP_FROM_EMAIL=your-email@qq.com
SMTP_FROM_NAME=AstraOS
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_LOG_CODE=false
